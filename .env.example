# Flask Configuration
FLASK_APP=dashboard_app/run.py
FLASK_ENV=development
# Also signs the admin-auth session cookie (see ADMIN_PASSWORD below) — must be a real generated
# secret, not left at any default, or the password gate can be bypassed by forging a session cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Admin password gate (see docs/architecture/02-admin-password-gate.md) — single shared password,
# blocks the whole dashboard until entered; resets whenever the browser is fully closed and reopened.
# Generate the hash for your chosen password with:
#   python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
# IMPORTANT: the generated hash contains literal "$" characters (e.g. scrypt:32768:8:1$salt$hash).
# docker-compose treats $word in .env as a variable reference and silently blanks it out if unset
# (you'll see "WARN ... variable is not set" and the value reaching the container gets corrupted,
# which fails every login attempt with no visible error). Double every "$" to "$$" before pasting:
#   scrypt:32768:8:1$$salt$$hash
ADMIN_PASSWORD=paste-the-generated-hash-here-with-dollar-signs-doubled

# Database Configuration
DATABASE_URL=sqlite:///instance/app.db

# Ollama Configuration
OLLAMA_MODEL=phi3.5
OLLAMA_HOST=http://localhost:11434

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-file.json

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
#NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
#NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here


# Project Specifics
PROJECT_ID=your-google-cloud-project-id
GCS_BUCKET_NAME=your-bucket-name

# GitHub Sync (github-sync container)
# Needs read access to Issues, Pull requests, and Metadata for every repo under your GitHub org:
# a fine-grained PAT scoped to your GitHub org, or a classic PAT with the "repo" scope if the repos are private.
GITHUB_TOKEN=your_github_personal_access_token_here
# Fast cadence (seconds): re-checks only Tasks currently In-Progress/Testing (default: 5)
SYNC_INTERVAL_SECONDS=5
# Slow cadence (seconds): full per-repo scan that discovers new issues and reconciles everything else (default: 60)
DISCOVERY_INTERVAL_SECONDS=60
